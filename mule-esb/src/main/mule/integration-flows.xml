    <!-- POST /api/v1/employees/batch/delete - Batch delete employees -->
    <flow name="batch-delete-employees-flow">
        <http:listener config-ref="HTTP_Listener_config" path="/api/v1/employees/batch/delete" allowedMethods="POST">
            <http:response statusCode="#[vars.httpStatus default 204]"/>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
