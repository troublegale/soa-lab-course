            </on-error-continue>
            <on-error-propagate type="ANY">
                <set-variable variableName="httpStatus" value="500"/>
                <ee:transform>
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/xml writeDeclaration=false
---
{
    appError: {
        code: 500,
        message: error.description default "Internal server error"
    }
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>

    <!-- POST /api/v1/employees/batch/update - Batch update employees -->
    <flow name="batch-update-employees-flow">
        <http:listener config-ref="HTTP_Listener_config" path="/api/v1/employees/batch/update" allowedMethods="POST">
