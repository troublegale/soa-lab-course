            </http:error-response>
        </http:listener>
        
        <logger level="INFO" message="[Mule ESB] GET employees for organization: #[attributes.uriParams.orgId]"/>
        
        <http:request config-ref="Called_Web_config" method="GET" path="/soa/api/v1/organizations/{orgId}/employees">
            <http:headers><![CDATA[#[{'Accept': 'application/xml'}]]]></http:headers>
            <http:uri-params><![CDATA[#[{'orgId': attributes.uriParams.orgId}]]]></http:uri-params>
